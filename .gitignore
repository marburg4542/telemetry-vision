# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
.venv-*/
venv/

# --- Generated output ---
output/

# --- Credentials ---
# A LINE channel access token is a bearer token: anyone holding it can push
# messages as this Official Account until it is revoked. configs/line.example.json
# is the template that IS tracked; the filled-in copy must never be.
configs/line.json
*.local.json
.env

# --- Model weights ---
# Hundreds of megabytes per checkpoint. They live in models/ and runs/*/weights
# on disk and are listed in configs/paths.yaml, but git never carries them.
models/
*.pt
*.onnx
*.engine

# --- Training-run artefacts ---
# Tracked: the curves, confusion matrices, results.csv and args.yaml. They are
# the record of what was trained, they are small, and report.py renders from
# them.
#
# Not tracked: weights, the sample-batch previews and the TensorBoard event
# files. Nothing in the repository reads the event files, and the previews are
# illustrative dumps that add roughly 7 MB per run — the three runs already
# committed account for 20 of the 23 MB in git.
#
# These rules stop the growth rather than rewriting it: files already committed
# stay tracked, because git ignore only applies to untracked paths and removing
# them from HEAD would not shrink the history anyway.
runs/*/weights/
runs/*/events.out.tfevents.*
runs/*/train_batch*.jpg
runs/*/val_batch*.jpg
runs/*/labels_correlogram.jpg
# train_batch0 and val_batch0_pred are the two the report embeds, so they stay.
!runs/*/train_batch0.jpg
!runs/*/val_batch0_pred.jpg

# --- Media and datasets ---
# Roughly 8 GB, kept outside the repository at configs/paths.yaml `asset_root`.
data/
dataset_frames/
datasets/
car-detection-3/
video_results/
*.mp4
*.avi
*.mov
*.mkv

# --- OCR results ---
# No blanket *.csv rule: it would swallow runs/*/results.csv, the per-epoch
# training log that has to stay in the repository. OCR writes into output/,
# which is ignored above.
*.jsonl
telemetry*.csv

# --- Empty directory Ultralytics drops when YOLO_CONFIG_DIR is unset ---
Ultralytics/

# --- Local switch, not a project decision ---
# Its presence turns on publishing capture images through a quick tunnel. That
# is a judgement about how sensitive one machine's footage is, so it belongs to
# the machine rather than to everyone who clones this.
configs/quick-tunnel.enabled
